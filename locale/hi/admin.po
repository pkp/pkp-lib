msgid "admin.cli.tool.jobs.maintenance.message"
msgstr ""
"कतार कार्यों (queue jobs) को नहीं चलाया जा सकता क्योंकि एप्लिकेशन का रखरखाव (maintenance) मोड सक्षम है।"

msgid "admin.cli.tool.jobs.sandbox.message"
