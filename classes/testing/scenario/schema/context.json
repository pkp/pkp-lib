{
    "title": "Test-harness context spec",
    "description": "An app-neutral context (journal / press / server). App-specific concepts enter through declared overlay properties added by the app's scenario controller (schemaOverlayProperties()), never through free-form passthrough.",
    "type": "object",
    "additionalProperties": false,
    "required": ["tag"],
    "properties": {
        "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Parallel-isolation key. Stored as the context acronym suffix and echoed back; every scenario request needs one."
        },
        "urlPath": {"type": "string", "minLength": 1, "maxLength": 32},
        "name": {"type": "string", "minLength": 1},
        "acronym": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "primaryLocale": {"type": "string"},
        "supportedLocales": {"type": "array", "items": {"type": "string"}},
        "users": {"type": "array", "items": {"$comment": "replaced at runtime with user.json"}},
        "categories": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "title"],
                "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "title": {"type": "string", "minLength": 1},
                    "description": {"type": "string"},
                    "parentPath": {"type": "string"}
                }
            }
        },
        "contactName": {"type": "string"},
        "contactEmail": {"type": "string"},
        "supportName": {"type": "string"},
        "supportEmail": {"type": "string"},
        "mailingAddress": {"type": "string"},
        "disableSubmissions": {"type": "boolean"},
        "enableAnnouncements": {"type": "boolean"},
        "enablePublicComments": {"type": "boolean"},
        "enableDois": {"type": "boolean"},
        "copyrightNotice": {"type": "string"},
        "defaultReviewMode": {"type": "integer"},
        "numWeeksPerResponse": {"type": "integer"},
        "numWeeksPerReview": {"type": "integer"},
        "keywords": {"type": "string"},
        "citations": {"type": "string"}
    }
}
