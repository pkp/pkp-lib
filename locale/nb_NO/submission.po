msgstr ""
"Denne innsendingen vil bli akseptert for publisering og sendt til redigering."

msgid "editor.submission.decision.accept.log"
msgstr ""
"{$editorName} aksepterte denne innsendingen og sendte den til "
"redigeringsstadiet."

msgid "editor.submission.decision.accept.completed"
msgstr "Innsendingen er akseptert"

msgid "editor.submission.decision.accept.completedDescription"
msgstr ""
"Innsendingen «{$title}» har blitt akseptert for publisering og er sendt til "
"redigeringsstadiet. Alle meldinger er sendt, unntatt de du måtte ha valgt å "
"hoppe over."

msgid "editor.submission.decision.accept.notifyAuthorsDescription"
msgstr ""
"Send en e-post til forfatterne for å la dem få vite at innsendingen deres "
"har blitt akseptert for publisering. Denne e-posten blir ikke sendt før du "
"har registrert beslutningen."

msgid "editor.submission.decision.cancelReviewRound.notifyAuthorsDescription"
msgstr ""
"Send en e-post til forfatterne for å la dem få vite at "
"fagfellevuderingsrunden er avsluttet. Denne e-posten blir ikke sendt før "
"beslutningen er registrert."

msgid "editor.submission.decision.decline"
msgstr "Avvis innlevering"

msgid "editor.submission.decision.decline.description"
msgstr ""
"Denne innsendingen blir ikke godtatt for publisering. "
"Fagfellevurderingsrunden blir stengt og innsendingen blir arkivert."

msgid "editor.submission.decision.decline.log"
msgstr "{$editorName} avviste denne innleveringen."

msgid "editor.submission.decision.decline.completed"
msgstr "Innleveringen er blitt avvist"

msgid "editor.submission.decision.decline.completed.description"
msgstr ""
"Innsendingen «{$title}» har blitt avslått og arkivert. Alle meldinger har "
"blitt sendt, unntatt de du måtte ha valgt å hoppe over."

msgid "editor.submission.decision.decline.notifyAuthorsDescription"
msgstr ""
"Send en e-post til forfatterne for å la dem få vite at innsendingen deres "
"har blitt avvist. Denne e-posten vil ikke bli sendt før beslutningen er "
"registrert."

msgid "editor.submission.decision.initialDecline.description"
msgstr ""
"Denne innsendingen vil bli avvist og ikke publisert. Ytterligere "
"fagfellevurdering vil ikke bli foretatt, og innsendingen vil bli arkivert."

