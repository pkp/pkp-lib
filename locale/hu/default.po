msgid "default.submission.step.beforeYouBegin"
msgstr ""
"<p>Köszönjük, hogy kéziratot kíván benyújtani a(z) {$contextName} "
"folyóirathoz. A beküldés során fel kell töltenie fájlokat, meg kell adnia a "
"társszerzőket, valamint a kézirat adatait, például a címet és az "
"összefoglalót.</p>\\<p>Ha még nem tette meg, kérjük, olvassa el a <a href=\""
"{$submissionGuidelinesUrl}\" target=\"_blank\">Szerzői útmutatót</a>. Az "
"űrlapok kitöltésekor adjon meg minél részletesebb információkat, hogy "
"segítse szerkesztőinket a kézirat értékelésében.</p>\\<p>A beküldési "
"folyamat megkezdése után mentheti a kézirat adatait, és később folytathatja "
"a beküldést. A végleges benyújtás előtt minden megadott adatot ellenőrizhet "
"és javíthat.</p>"

msgid "default.submission.step.uploadFiles"
msgstr ""
"<p>Töltsön fel minden olyan fájlt, amelyre szerkesztőségünknek szüksége "
"lehet a kézirat elbírálásához. A kézirat főszövege mellett adatállományokat, "
"összeférhetetlenségi nyilatkozatokat vagy egyéb kiegészítő fájlokat is "
"feltölthet, ha ezek segíthetik szerkesztőink munkáját.</p>"

msgid "default.submission.step.contributors"
msgstr ""
"<p>Adja meg a kézirat valamennyi közreműködőjének adatait. Az itt megadott "
"közreműködők e-mailben visszaigazolást kapnak a kézirat benyújtásáról, "
"valamint értesítést a kézirattal kapcsolatos valamennyi szerkesztői "
"döntésről.</p>\\<p>Ha valamelyik közreműködővel nem lehet e-mailben "
"kapcsolatba lépni, mert névtelennek kell maradnia, vagy nincs e-mail címe, "
"kérjük, ne adjon meg fiktív e-mail címet. A beküldési folyamat egy későbbi "
"lépésében, a szerkesztőnek szóló üzenetben adhat tájékoztatást erről a "
"közreműködőről.</p>"

msgid "default.submission.step.details"
msgstr ""
"<p>Kérjük, adja meg az alábbi adatokat, hogy megkönnyítse a kézirat "
"kezelését a rendszerünkben.</p>"

msgid "default.submission.step.forTheEditors"
msgstr ""
"<p>Kérjük, adja meg az alábbi adatokat, hogy segítse szerkesztőségünket a "
"kézirat kezelésében.</p>\\<p>A metaadatok megadásakor olyan információkat "
"adjon meg, amelyek a leghasznosabbak lehetnek a kéziratot kezelő szerkesztő "
"számára. Ezek az adatok a megjelenés előtt módosíthatók.</p>"

msgid "default.submission.step.review"
msgstr ""
"<p>A kézirat benyújtásának véglegesítése előtt ellenőrizze a megadott "
"adatokat. Az egyes szakaszok tetején található szerkesztés gombra kattintva "
"bármelyik itt megjelenített adatot módosíthatja.</p>\\<p>A kézirat "
"benyújtását követően szerkesztőségünk egyik tagját bízzuk meg annak "
"elbírálásával. Kérjük, ügyeljen arra, hogy az itt megadott adatok a lehető "
"legpontosabbak legyenek.</p>"

msgid "default.groups.name.editorialBoardMember"
msgstr "Szerkesztőbizottsági tag"

msgid "default.groups.plural.editorialBoardMember"
msgstr "Szerkesztőbizottsági tagok"

msgid "default.groups.abbrev.editorialBoardMember"
msgstr "SZBT"

msgid "default.submission.step.reviewerSuggestions"
msgstr ""
"<p>A kézirat benyújtásakor lehetősége van több lehetséges lektort is "
"javasolni. Ez elősegítheti a lektorálási folyamat gördülékenyebb "
"lebonyolítását, és hasznos információkkal szolgálhat a szerkesztőség "
"számára. Kérjük, olyan lektorokat javasoljon, akik a szakterület elismert "
"szakértői, és akik esetében nem áll fenn összeférhetetlenség a kézirattal "
"kapcsolatban. Ez a lehetőség a lektorálási folyamat hatékonyságát hivatott "
"növelni, megkönnyítve mind a szerzők, mind a szerkesztőség munkáját.</p>"
