msgid "emails.userRoleAssignmentInvitationNotify.body"
msgstr ""
"<div class='email-container'>    <div class='email-header'>        "
"<h2>Invitasjon til en ny rolle</h2>    </div>    <div class='email-"
"content'>        <p>Kjære {$recipientName},</p>        <p> {$inviterName} "
"inviterer deg til å påta deg en ny rolle i {$contextName}.</p>        <p>Vi "
"bryr oss om personvern i {$contextName}. Derfor har vi tatt skritt for å "
"sikre at vi behandler informasjon i samsvar med GDPR. Dette includerer at du "
"selv må legge inn informasjon og bestemme hvem som kan se denne "
"informasjonen. For ytterligere informasjon om hvordan vi håndterte din "
"informasjon, se vår Privacy Policy.</p>        <div>{$existingRoles}</"
"div>        <div>{$rolesAdded}</div>        <p>Når du aksepterer "
"invitasjonen blir du sendt videre til {$contextName}.</p>        <p>Ta "
"gjerne kontakt med meg om du har spørsmål om prosessen.</p> <table class"
"='btn-wrap' role='presentation' border='0' cellpadding='0' "
"cellspacing='10'>             <tr><td class='btn-cell btn-accept'  bgcolor='#"
"28a745'><a class='btn' href='{$acceptUrl}'>Aksepter invitasjon</a></td></"
"tr>             <table class='btn-wrap' role='presentation' border='0' "
"cellpadding='0' cellspacing='10'> <tr><td class='btn-cell btn-decline' "
"bgcolor='#dc3545'><a class='btn' href='{$declineUrl}'>Avslå "
"invitasjon</a></td></tr>        </table>        <p>Med vennlig hilsen,</"
"p>        <p>{$contextName}</p>    </div></div>"
