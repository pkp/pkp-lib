msgid "admin.systemInfo.settingName"
msgstr "सेटिंग का नाम"

msgid "admin.systemInfo.settingValue"
msgstr "सेटिंग का मान"

msgid "admin.adminFunctions"
msgstr "प्रशासनिक कार्य"

msgid "admin.deleteCache"
msgstr "कैश (Caches) हटाएँ"

msgid "admin.deleteCache.description"
msgstr ""
"सिस्टम से कैश फ़ाइलें हटाएँ। यह केवल विकास (development) परिवेश में "
"किया जाना चाहिए।"

msgid "admin.clearDataCache"
msgstr "डेटा कैश हटाएँ"

msgid "admin.clearTemplateCache"
msgstr "टेम्प्लेट कैश हटाएँ"

msgid "admin.configFileUpdatedInstructions"
msgstr ""
"आपकी कॉन्फ़िगरेशन फ़ाइल सफलतापूर्वक अपडेट कर दी गई है। कृपया ध्यान दें कि यदि "
"आपकी साइट अब सही ढंग से काम नहीं करती है तो आपको सीधे <tt>config.inc.php</tt> "
"को संपादित करके मैन्युअल रूप से अपने कॉन्फ़िगरेशन को ठीक करने की आवश्यकता हो सकती है।"

msgid "admin.confirmClearTemplateCache"
msgstr "क्या आप वाकई संकलित (compiled) टेम्प्लेट का कैश साफ़ करना चाहते हैं?"

msgid "admin.confirmExpireSessions"
msgstr ""
"क्या आप वाकई सभी उपयोगकर्ता सत्र (sessions) समाप्त करना चाहते हैं? "
"सिस्टम में वर्तमान में लॉग इन सभी उपयोगकर्ताओं को फिर से लॉग इन करने के लिए "
"मजबूर किया जाएगा (आप स्वयं सहित)।"

msgid "admin.contentsOfConfigFile"
msgstr "कॉन्फ़िगरेशन फ़ाइल की सामग्री"

msgid "admin.contexts.confirmDelete"
msgstr ""
"क्या आप वाकई {$contextName} और इसकी सभी सामग्री को स्थायी रूप से हटाना "
"चाहते हैं?"

msgid "admin.currentVersion"
msgstr "वर्तमान संस्करण"

msgid "admin.dateInstalled"
msgstr "स्थापना की तिथि"

msgid "admin.displayConfigFileInstructions"
msgstr ""
"आपके अद्यतन कॉन्फ़िगरेशन की सामग्री नीचे प्रदर्शित की गई है। कॉन्फ़िगरेशन परिवर्तनों को लागू "
"करने के लिए आपको एक उपयुक्त टेक्स्ट एडिटर में <tt>config.inc.php</tt> खोलना होगा "
"और इसकी सामग्री को नीचे दिए गए टेक्स्ट फ़ील्ड की सामग्री से बदलना होगा।"

msgid "admin.displayNewSystemConfig"
msgstr "नया कॉन्फ़िगरेशन प्रदर्शित करें"

msgid "admin.expireSessions"
msgstr "उपयोगकर्ता सत्र (Sessions) समाप्त करें"

msgid "admin.expireSessions.description"
msgstr ""
"आपको सहित, सभी उपयोगकर्ताओं को एप्लिकेशन से तुरंत लॉग आउट कर दिया जाएगा, "
"और फिर से लॉग इन करने की आवश्यकता होगी।"

msgid "admin.languages.cantDisable"
msgstr ""
"यह लोकेल (locale) साइट की प्राथमिक भाषा है। जब तक आप कोई अन्य प्राथमिक लोकेल "
"नहीं चुनते तब तक आप इसे अक्षम नहीं कर सकते।"

msgid "admin.languages.confirmSitePrimaryLocaleChange"
msgstr ""
"क्या आप वाकई साइट का प्राथमिक लोकेल (locale) बदलना चाहते हैं? उपयोगकर्ताओं के नाम, जो "
"साइट के प्राथमिक लोकेल में आवश्यक हैं, मौजूदा प्राथमिक लोकेल से कॉपी किए जाएंगे "
"जहां वे गायब हैं।"

msgid "admin.languages.confirmReload"
msgstr ""
"क्या आप वाकई इस लोकेल को पुनः लोड करना चाहते हैं? यह किसी भी मौजूदा "
"लोकेल-विशिष्ट डेटा जैसे कि अनुकूलित ईमेल टेम्प्लेट को मिटा देगा।"

msgid "admin.languages.installedLocales"
msgstr "स्थापित लोकेल (Locales)"

msgid "admin.languages.installLanguages"
msgstr "लोकेल प्रबंधित करें"

msgid "admin.languages.availableLocales"
msgstr "उपलब्ध लोकेल"

msgid "admin.languages.installLocale"
msgstr "लोकेल स्थापित (Install) करें"

msgid "admin.languages.installLocales"
msgstr "स्थापित (Install) करें"

msgid "admin.languages.installNewLocales"
msgstr "नए लोकेल स्थापित करें"

msgid "admin.languages.languageSettings"
msgstr "भाषा सेटिंग्स"

msgid "admin.languages.noLocalesAvailable"
msgstr "स्थापना के लिए कोई अतिरिक्त लोकेल उपलब्ध नहीं है।"

msgid "admin.languages.reload"
msgstr "लोकेल पुनः लोड (Reload) करें"

msgid "admin.languages.uninstall"
msgstr "लोकेल अनइंस्टॉल करें"

msgid "admin.phpInfo"
msgstr "विस्तृत PHP जानकारी"

msgid "admin.scheduledTask"
msgstr "निर्धारित कार्य (Scheduled task)"

msgid "admin.scheduledTask.startTime"
msgstr "कार्य प्रक्रिया शुरू हुई।"

msgid "admin.scheduledTask.stopTime"
msgstr "कार्य प्रक्रिया रुक गई।"

msgid "admin.scheduledTask.noLog"
msgstr "कार्य ने कोई लॉग उत्पन्न नहीं किया।"

msgid "admin.scheduledTask.depositDois"
msgstr "कॉन्फ़िगर की गई पंजीकरण एजेंसी के पास DOI जमा करें"

msgid "admin.scheduledTask.downloadLog"
msgstr ""
"आपकी {$softwareName} स्थापना ने स्वचालित रूप से इस कार्य को निष्पादित और "
"पूरा कर लिया है और आप यहां से लॉग फ़ाइल डाउनलोड कर सकते हैं: {$url}"

msgid "admin.scheduledTask.editorialReminder"
msgstr "प्रत्येक संपादक को उनके बकाया कार्यों की याद दिलाने के लिए एक ईमेल भेजें"

msgid "admin.scheduledTask.editorialReminder.logStart"
msgstr "संदर्भ {$contextId} में याद दिलाने के लिए संपादकों की पहचान की जा रही है"

msgid "admin.scheduledTask.editorialReminder.logEnd"
msgstr ""
"संदर्भ {$contextId} में उपयोगकर्ताओं {$userIds} को संपादकीय ईमेल अनुस्मारक "
"भेजने के लिए {$count} कार्य (jobs) प्रेषित किए गए"

msgid "admin.scheduledTask.confirmClearLogs"
msgstr "क्या आप वाकई सभी निर्धारित कार्य निष्पादन लॉग हटाना चाहते हैं?"

msgid "admin.scheduledTask.clearLogs"
msgstr "निर्धारित कार्य लॉग साफ़ करें"

msgid "admin.scheduledTask.clearLogs.description"
msgstr "चलाए गए निर्धारित कार्य प्रक्रियाओं के सभी लॉग हटाएँ।"

msgid "admin.scheduledTask.clearLogs.delete"
msgstr "कार्य लॉग हटाएँ"

msgid "admin.scheduledTask.publishSubmissions"
msgstr "प्रकाशन के लिए निर्धारित सबमिशन प्रकाशित करें"

msgid "admin.scheduledTask.reviewReminder"
msgstr "समीक्षा अनुस्मारक (Review reminder)"

msgid "admin.scheduledTask.statisticsReport"
msgstr "संपादकीय रिपोर्ट अधिसूचना"

msgid "admin.scheduledTask.subscriptionExpiryReminder"
msgstr "सदस्यता समाप्ति अनुस्मारक"

msgid "admin.scheduledTask.removeUnvalidatedExpiredUsers"
msgstr "असत्यापित समाप्त उपयोगकर्ताओं को हटाएँ"

msgid "admin.scheduledTask.removeFailedJobs"
msgstr "विफल कार्य सूची से बहुत पुराने विफल कार्यों (failed jobs) को हटाएँ।"

msgid "admin.scheduledTask.processQueueJobs"
msgstr "लंबित कतार (queue) कार्यों को संसाधित करें"

msgid "admin.scheduledTask.updateGeoDB"
msgstr "DB-IP city lite डेटाबेस अपडेट करें"

msgid "admin.scheduledTask.updateGeoDB.fileRename.error"
msgstr ""
"DB-IP city lite डेटाबेस फ़ाइल {$sourceFilename} का नाम बदलकर "
"{$targetFilename} करना विफल रहा।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset"
msgstr "ROR रजिस्ट्री डेटासेट कैश (cache) अपडेट करें"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.checksum"
msgstr ""
"चेकसम बेमेल (checksum mismatch) के कारण ROR रजिस्ट्री डेटासेट को अपडेट करने में "
"असमर्थ। अपेक्षित चेकसम: {$expected}। वास्तविक चेकसम: {$actual}।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.checksumVerify"
msgstr "डाउनलोड किए गए ROR रजिस्ट्री डेटासेट ZIP फ़ाइल के चेकसम को सत्यापित करने में असमर्थ।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.checksumAlgorithm"
msgstr "ROR रजिस्ट्री डेटासेट ZIP फ़ाइल को सत्यापित करने में असमर्थ: असमर्थित चेकसम एल्गोरिदम। केवल MD5 और SHA256 समर्थित हैं।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.statusCode"
msgstr "ROR रजिस्ट्री डेटासेट मेटाडेटा पुनर्प्राप्त करने में असमर्थ। अप्रत्याशित HTTP स्थिति कोड: {$statusCode}।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.noDownloadFile"
msgstr "ROR रजिस्ट्री डेटासेट मेटाडेटा पुनर्प्राप्त करने में असमर्थ। API प्रतिक्रिया में कोई डाउनलोड फ़ाइल नहीं मिली।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.download"
msgstr "ROR रजिस्ट्री डेटासेट ZIP फ़ाइल डाउनलोड करने में असमर्थ।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.zipOpen"
msgstr "ROR रजिस्ट्री डेटासेट ZIP फ़ाइल खोलने में असमर्थ। त्रुटि कोड: {$code}।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.extract"
msgstr "ROR रजिस्ट्री डेटासेट ZIP फ़ाइल को निकालने (extract) में असमर्थ।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.jsonNotFound"
msgstr "निकाले गए ROR रजिस्ट्री डेटासेट में स्कीमा संस्करण {$version} वाली JSON डेटा फ़ाइल खोजने में असमर्थ।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.missingFields"
msgstr "आईडी (id) \"{$id}\" वाले ROR रजिस्ट्री रिकॉर्ड में एक या अधिक आवश्यक फ़ील्ड (id, names, status) गायब हैं और इसे छोड़ दिया गया है।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.schemaVersionRead"
msgstr "ROR रजिस्ट्री JSON फ़ाइल {$file} से स्कीमा संस्करण पढ़ने में असमर्थ। त्रुटि: {$error}।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.error.noRecordsProcessed"
msgstr "ROR रजिस्ट्री डेटासेट से किसी भी रिकॉर्ड को संसाधित नहीं किया गया। डेटासेट खाली हो सकता है या सभी रिकॉर्ड सत्यापन में विफल रहे।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.warning.missingNameValue"
msgstr "ROR रजिस्ट्री रिकॉर्ड \"{$id}\" में एक नाम प्रविष्टि है जिसका प्रकार [{$types}] आवश्यक 'value' फ़ील्ड से गायब है और उसे छोड़ दिया गया है।"

msgid "admin.scheduledTask.UpdateRorRegistryDataset.warning.noValidName"
msgstr "ROR रजिस्ट्री रिकॉर्ड \"{$id}\" का कोई मान्य नाम नहीं है और इसे छोड़ दिया गया है।"

msgid "admin.scheduledTask.usageStatsLoader"
msgstr "उपयोग आँकड़े फ़ाइल लोडर कार्य (Usage statistics file loader task)"

msgid "admin.scheduledTask.usageStatsLoader.processingPathNotEmpty"
msgstr ""
"निर्देशिका {$directory} खाली नहीं है। यह पहले से विफल प्रक्रिया, या "
"समवर्ती रूप से चल रही प्रक्रिया का संकेत दे सकता है। यह फ़ाइल "
"स्वचालित रूप से पुनः संसाधित की जाएगी।"

msgid "admin.job.processLogFile.openFileFailed"
msgstr "फ़ाइल {$file} को खोला नहीं जा सका और अस्वीकार कर दिया गया।"

msgid "admin.scheduledTask.usageStatsLoader.veryOldLogFile"
msgstr ""
"फ़ाइल {$file} पुराने लॉग फ़ाइल प्रारूप में है जिसे संसाधित नहीं किया जा सकता "
"है और इस प्रकार इसे वापस स्टेज निर्देशिका में ले जाया जाएगा।"

msgid "admin.scheduledTask.usageStatsLoader.monthExists"
msgstr ""
"लॉग फ़ाइल {$file} को छोड़ दिया गया क्योंकि उस महीने के आँकड़ों की "
"गणना पहले ही की जा चुकी है। पिछले महीने के आँकड़ों की पुनर्गणना करने के लिए, आपको "
"उस महीने की सभी लॉग फ़ाइलों को पुनर्स्थापित करना होगा और आँकड़ों को "
"पुनः संसाधित करने के लिए CLI टूल का उपयोग करना होगा।"

msgid "admin.job.processLogFile.wrongLoglineFormat"
msgstr ""
"लॉग फ़ाइल {$file} में पंक्ति {$lineNumber} गलत प्रारूप में है और "
"इस प्रकार इसे छोड़ दिया जाएगा।"

msgid "admin.job.processLogFile.invalidLogEntry"
msgstr ""
"लॉग फ़ाइल {$file} में पंक्ति {$lineNumber} पर अमान्य लॉग प्रविष्टि: {$error}"

msgid "admin.job.processLogFile.invalidLogEntry.time"
msgstr "समय (Time) एक मान्य तिथि नहीं है।"

msgid "admin.job.processLogFile.invalidLogEntry.contextId"
msgstr "संदर्भ आईडी (Context ID) एक पूर्णांक नहीं है।"

msgid "admin.job.processLogFile.invalidLogEntry.submissionId"
msgstr "सबमिशन आईडी (Submission ID) एक पूर्णांक नहीं है।"

msgid "admin.job.processLogFile.invalidLogEntry.representationId"
msgstr "प्रतिनिधित्व आईडी (Representation ID) एक पूर्णांक नहीं है।"

msgid "admin.job.processLogFile.invalidLogEntry.assocType"
msgstr "Assoc प्रकार (Assoc type) समर्थित नहीं है।"

msgid "admin.job.processLogFile.invalidLogEntry.fileType"
msgstr "फ़ाइल प्रकार (File type) समर्थित नहीं है।"

msgid "admin.job.processLogFile.invalidLogEntry.country"
msgstr "देश (Country) दो अक्षरों वाली वर्णमाला स्ट्रिंग नहीं है।"

msgid "admin.job.processLogFile.invalidLogEntry.region"
msgstr "क्षेत्र (Region) तीन अल्फ़ान्यूमेरिक वर्णों तक लंबी स्ट्रिंग नहीं है।"

msgid "admin.job.processLogFile.invalidLogEntry.institutionIds"
msgstr "संस्थान आईडी (Institution IDs) एक ऐरे (array) नहीं है।"

msgid "admin.job.processLogFile.insertError"
msgstr ""
"लॉग फ़ाइल {$file} को पंक्ति {$lineNumber} पर संसाधित करते समय "
"त्रुटि उत्पन्न हुई: {$msg}"

msgid "admin.scheduledTask.usageStatsLoader.jobDispatched"
msgstr ""
"लॉग फ़ाइलों को संसाधित करने और सांख्यिकी डेटा संग्रहीत करने वाले "
"पृष्ठभूमि (background) कार्य प्रेषित (dispatched) कर दिए गए हैं।"

