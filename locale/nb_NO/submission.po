msgstr ""
"Avslutt den pågående fagfellevurderingsrunden og send innsendingen tilbake "
"til foregående fagfellevurderingsrunde. Om pågående runde er første runde "
"blir innsendingen sendt tilbake til innsendingsstadiet."

msgid "editor.submission.decision.cancelReviewRound.log"
msgstr "{$editorName} kansellerte fagfellevurderingsrunden."

msgid "editor.submission.decision.cancelReviewRound.completed"
msgstr "Avsluttet den siste fagfellevurderingsrunden."

msgid "editor.submission.decision.cancelReviewRound.completed.description"
msgstr ""
"Fagfellevurderingsrunden for innsendingen {$title} har blitt avsluttet. Alle "
"meldinger har blitt sendt, unntatt de du måtte ha hoppet over."

